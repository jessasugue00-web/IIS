@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var navFirst = User.FindFirst("FirstName")?.Value ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Information System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuth ? "has-sidebar" : "")">

    @if (isAuth)
    {
        <!-- LEFT SIDEBAR -->
        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                Information System
            </a>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index"
                   class="@(controller == "Home" ? "active" : "")">
                    <i class="bi bi-grid"></i> Dashboard
                </a>

                <a asp-controller="Instructors" asp-action="Index"
                   class="@(controller == "Instructors" ? "active" : "")">
                    <i class="bi bi-people"></i> Instructors
                </a>

                <a asp-controller="Departments" asp-action="ICS"
                   class="@(controller == "Departments" && action == "ICS" ? "active" : "")">
                    <i class="bi bi-laptop"></i> ICS List
                </a>

                <a asp-controller="Departments" asp-action="IED"
                   class="@(controller == "Departments" && action == "IED" ? "active" : "")">
                    <i class="bi bi-mortarboard"></i> IED List
                </a>

                <a asp-controller="Account" asp-action="Profile"
                   class="@(controller == "Account" && action == "Profile" ? "active" : "")">
                    <i class="bi bi-person"></i> My Profile
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    @navFirst
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-button">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </aside>
    }
    else
    {
        <!-- TOP BAR FOR LOGIN / REGISTER -->
        <header class="site-header">
            <a asp-controller="Account" asp-action="Login" class="site-brand">
                Information System
            </a>
            <nav class="site-nav">
                <a asp-controller="Account" asp-action="Login"
                   class="@(action == "Login" ? "active" : "")">Login</a>
                <a asp-controller="Account" asp-action="Register"
                   class="@(action == "Register" ? "active" : "")">Register</a>
            </nav>
        </header>
    }

    <div class="content-wrap">
        <main class="main-content">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <p class="mb-0">&copy; @DateTime.Now.Year - Information System</p>
        </footer>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div data-popup-message="@message" hidden></div>
    }

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
